+package net.onelitefeather.blackhole.backend.cache;
+
+import io.lettuce.core.RedisClient;
+import io.lettuce.core.api.StatefulRedisConnection;
+import io.micronaut.core.type.Argument;
+import io.micronaut.serde.ObjectMapper;
+import net.onelitefeather.blackhole.backend.playerresolver.ResolvedPlayer;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.testcontainers.containers.GenericContainer;
+
+import java.time.Duration;
+import java.util.Optional;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Runs {@link SharedCache} against a real Redis-protocol server (Testcontainers). Needs Docker, so it
+ * is tagged {@code integration} and excluded from the default test task.
+ */
+@Tag("integration")
+class SharedCacheIntegrationTest {
+
+    private static final GenericContainer<?> SERVER = new GenericContainer<>("redis:8-alpine").withExposedPorts(6379);
+    private static RedisClient client;
+    private static StatefulRedisConnection<String, String> connection;
+
+    @BeforeAll
+    static void startServer() {
+        SERVER.start();
+        client = RedisClient.create("redis://" + SERVER.getHost() + ":" + SERVER.getMappedPort(6379));
+        connection = client.connect();
+    }
+
+    @AfterAll
+    static void stopServer() {
+        connection.close();
+        client.shutdown();
+        SERVER.stop();
+    }
+
+    private static SharedCache cache() {
+        return new SharedCache(connection, ObjectMapper.getDefault(), Duration.ofSeconds(2));
+    }
+
+    @Test
+    void aPutIsReadBackAsTheSameValue() {
+        String key = CacheKeys.player("RoundTrip");
+        ResolvedPlayer resolved = new ResolvedPlayer(UUID.randomUUID(), "RoundTrip", "otis");
+        SharedCache cache = cache();
+
+        cache.put(key, Argument.of(ResolvedPlayer.class), resolved, Duration.ofMinutes(1));
+
+        assertEquals(Optional.of(resolved), cache.get(key, Argument.of(ResolvedPlayer.class)));
+    }
+
+    @Test
+    void anEntryIsGoneAfterItsTtl() throws InterruptedException {
+        String key = "blackhole:cache:v1:test:expiry";
+        SharedCache cache = cache();
+        cache.put(key, Argument.of(String.class), "short-lived", Duration.ofMillis(200));
+
+        Thread.sleep(500);
+
+        assertTrue(cache.get(key, Argument.of(String.class)).isEmpty());
+    }
+
+    @Test
+    void evictRemovesTheEntry() {
+        String key = "blackhole:cache:v1:test:evict";
+        SharedCache cache = cache();
+        cache.put(key, Argument.of(String.class), "to-be-evicted", Duration.ofMinutes(1));
+
+        cache.evict(key);
+
+        assertFalse(cache.get(key, Argument.of(String.class)).isPresent());
+    }
+}
