# Rendered at container start by the nginx image (envsubst, only BLACKHOLE_* variables).
#
# THE UI AND THE API IT PROXIES HAVE NO AUTHENTICATION. Anyone who can reach this port can ban,
# unban and edit sections and templates. Run it on a private network, behind a VPN, or behind a
# reverse proxy that authenticates users. To restrict by address right here, uncomment:
#
#   allow 10.0.0.0/8;
#   allow 192.168.0.0/16;
#   deny all;
#
# or require a login with HTTP basic auth (create the file with `htpasswd -c`):
#
#   auth_basic           "Blackhole";
#   auth_basic_user_file /etc/nginx/htpasswd;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Written by /docker-entrypoint.d/40-config-json.sh from BLACKHOLE_UI_SOURCE / BLACKHOLE_UI_REVIEWER.
    location = /config.json {
        alias /tmp/config/config.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The trailing slash on proxy_pass strips the /api prefix: /api/player/resolve/Steve reaches
    # the backend as /player/resolve/Steve.
    location /api/ {
        proxy_pass ${BLACKHOLE_BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Built files carry a content hash in their name and never change.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Single page app: unknown paths (e.g. /players/<hash>) fall back to index.html.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
