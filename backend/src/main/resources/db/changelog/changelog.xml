<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- PostgreSQL-only consolidated baseline. Every deployment starts on an empty database, so
         there is no history to replay. Native changeTypes only; JSON columns are jsonb.
         shortcut: no CHECK constraints (JSON validity, ordinal enum ranges) - Liquibase XML has no
         portable changeType for them; enforced in the application layer. -->

    <!-- punishment_templates -->
    <changeSet id="pg-create-punishment-templates" author="blackhole">
        <createTable tableName="punishment_templates">
            <column name="identifier" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meta_data" type="jsonb"/>
            <column name="reason" type="varchar(255)"/>
            <column name="type" type="smallint"/>
            <column name="elo_delta" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-punishment-templates" author="blackhole">
        <createIndex indexName="IDXfb0n1048swedl734iua11xgh6" tableName="punishment_templates">
            <column name="identifier"/>
        </createIndex>
    </changeSet>

    <!-- punishments -->
    <changeSet id="pg-create-punishments" author="blackhole">
        <createTable tableName="punishments">
            <column name="identifier" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meta_data" type="jsonb"/>
            <column name="scope" type="varchar(255)"/>
            <column name="source" type="uuid"/>
            <column name="type" type="smallint"/>
            <column name="template_identifier" type="uuid"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-punishments" author="blackhole">
        <createIndex indexName="IDXbg1863u12hbsiqggy1kxv84gj" tableName="punishments">
            <column name="identifier"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="FKsystxtartkbg3pelwij5y444y"
                                  baseTableName="punishments" baseColumnNames="template_identifier"
                                  referencedTableName="punishment_templates" referencedColumnNames="identifier"/>
    </changeSet>

    <!-- punishment_profiles: owner is the sole primary key -->
    <changeSet id="pg-create-punishment-profiles" author="blackhole">
        <createTable tableName="punishment_profiles">
            <column name="owner" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meta_data" type="jsonb"/>
            <column name="active_ban_identifier" type="varchar(255)">
                <constraints unique="true" uniqueConstraintName="UKjenhq1urh55q6qbhxbor43mpr"/>
            </column>
            <column name="active_chat_ban_identifier" type="varchar(255)">
                <constraints unique="true" uniqueConstraintName="UK3bfpsh5gh8uybcnqn6ist0ju3"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-punishment-profiles" author="blackhole">
        <createIndex indexName="IDXs2rqilyfwjja2eh18bvdkgssg" tableName="punishment_profiles">
            <column name="owner"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="FK44vycpq38twfwo4pm864edwtf"
                                  baseTableName="punishment_profiles" baseColumnNames="active_chat_ban_identifier"
                                  referencedTableName="punishments" referencedColumnNames="identifier"/>
        <addForeignKeyConstraint constraintName="FKrg26gk6cng7up213jiux4ugap"
                                  baseTableName="punishment_profiles" baseColumnNames="active_ban_identifier"
                                  referencedTableName="punishments" referencedColumnNames="identifier"/>
    </changeSet>

    <!-- punishment_profiles_punishments -->
    <changeSet id="pg-create-punishment-profiles-punishments" author="blackhole">
        <createTable tableName="punishment_profiles_punishments">
            <column name="punishment_profile_entity_owner" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="history_identifier" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK72hdqv4fhab29f7yg9a80d1nt"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-punishment-profiles-punishments" author="blackhole">
        <addForeignKeyConstraint constraintName="FK7yf2av2hp2nfq84philn3588l"
                                  baseTableName="punishment_profiles_punishments" baseColumnNames="history_identifier"
                                  referencedTableName="punishments" referencedColumnNames="identifier"/>
        <addForeignKeyConstraint constraintName="fk_punishment_profiles_punishments_owner"
                                  baseTableName="punishment_profiles_punishments" baseColumnNames="punishment_profile_entity_owner"
                                  referencedTableName="punishment_profiles" referencedColumnNames="owner"/>
    </changeSet>

    <!-- punishment_evidence -->
    <changeSet id="pg-create-punishment-evidence" author="blackhole">
        <createTable tableName="punishment_evidence">
            <column name="identifier" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="captured_content_hash" type="varchar(255)"/>
            <column name="evidence_type" type="smallint"/>
            <column name="meta_data" type="jsonb"/>
            <column name="reference_id" type="varchar(255)"/>
            <column name="retention_expires_at" type="bigint"/>
            <column name="punishment_identifier" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-punishment-evidence" author="blackhole">
        <createIndex indexName="IDXeowdvehtn2mq9ratnjjt10mx0" tableName="punishment_evidence">
            <column name="identifier"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="FK1fcfw3b9ah8l5ywj1ksemk98r"
                                  baseTableName="punishment_evidence" baseColumnNames="punishment_identifier"
                                  referencedTableName="punishments" referencedColumnNames="identifier"/>
    </changeSet>

    <!-- reports -->
    <changeSet id="pg-create-reports" author="blackhole">
        <createTable tableName="reports">
            <column name="identifier" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category" type="smallint"/>
            <column name="created_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(1000)"/>
            <column name="meta_data" type="jsonb"/>
            <column name="reported_hash" type="varchar(255)"/>
            <column name="reporter_hash" type="varchar(255)"/>
            <column name="resolution_note" type="varchar(1000)"/>
            <column name="resolved_by" type="uuid"/>
            <column name="status" type="smallint"/>
            <column name="updated_at" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-reports" author="blackhole">
        <createIndex indexName="IDXcdecaabcx0057rmwougq4lln8" tableName="reports">
            <column name="identifier"/>
        </createIndex>
        <createIndex indexName="IDXhucb8heess4o7s9d641njq2e0" tableName="reports">
            <column name="reporter_hash"/>
        </createIndex>
    </changeSet>

    <!-- report_evidence_references -->
    <changeSet id="pg-create-report-evidence-references" author="blackhole">
        <createTable tableName="report_evidence_references">
            <column name="report_identifier" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="evidence_identifier" type="uuid"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-report-evidence-references" author="blackhole">
        <addForeignKeyConstraint constraintName="FK27b8gnu183fwcp3f8ixk9xw49"
                                  baseTableName="report_evidence_references" baseColumnNames="report_identifier"
                                  referencedTableName="reports" referencedColumnNames="identifier"/>
    </changeSet>

    <!-- elo_profiles: owner is the sole primary key -->
    <changeSet id="pg-create-elo-profiles" author="blackhole">
        <createTable tableName="elo_profiles">
            <column name="owner" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chat_elo" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="chat_elo_updated_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="gameplay_elo" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="gameplay_elo_updated_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="meta_data" type="jsonb"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-elo-profiles" author="blackhole">
        <createIndex indexName="IDX5k6jltfkea67v5ai92cey03u7" tableName="elo_profiles">
            <column name="owner"/>
        </createIndex>
    </changeSet>

    <!-- elo_events -->
    <changeSet id="pg-create-elo-events" author="blackhole">
        <createTable tableName="elo_events">
            <column name="identifier" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="delta" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="meta_data" type="jsonb"/>
            <column name="owner" type="varchar(255)"/>
            <column name="reason_code" type="smallint"/>
            <column name="resulting_score" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="source_evidence_id" type="uuid"/>
            <column name="track" type="smallint"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-elo-events" author="blackhole">
        <createIndex indexName="IDX1vli9egxhskmxh09x7ippe01p" tableName="elo_events">
            <column name="identifier"/>
        </createIndex>
        <createIndex indexName="IDX8kfktno2r37fryp23hbrywxge" tableName="elo_events">
            <column name="owner"/>
        </createIndex>
    </changeSet>

    <!-- appeals -->
    <changeSet id="pg-create-appeals" author="blackhole">
        <createTable tableName="appeals">
            <column name="identifier" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="appellant_hash" type="varchar(255)"/>
            <column name="created_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="decided_by" type="uuid"/>
            <column name="decision_note" type="varchar(2000)"/>
            <column name="eligibility_check_result" type="jsonb"/>
            <column name="meta_data" type="jsonb"/>
            <column name="statement" type="varchar(2000)"/>
            <column name="status" type="smallint"/>
            <column name="updated_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="punishment_identifier" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-appeals" author="blackhole">
        <createIndex indexName="IDXkumdsu9qt44a38mg4k9ngyp87" tableName="appeals">
            <column name="identifier"/>
        </createIndex>
        <createIndex indexName="IDX9faypy3gxh4xmiqii41ypsj5k" tableName="appeals">
            <column name="appellant_hash"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="FKqb76lk2ldlufmeevnpme8l94m"
                                  baseTableName="appeals" baseColumnNames="punishment_identifier"
                                  referencedTableName="punishments" referencedColumnNames="identifier"/>
    </changeSet>

    <!-- ip_correlation_tokens -->
    <changeSet id="pg-create-ip-correlation-tokens" author="blackhole">
        <createTable tableName="ip_correlation_tokens">
            <column name="identifier" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_seen" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="last_seen" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="meta_data" type="jsonb"/>
            <column name="occurrence_count" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="owner_hash" type="varchar(255)"/>
            <column name="token" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="pg-constraints-ip-correlation-tokens" author="blackhole">
        <createIndex indexName="IDXej580909u0b2cronpaairkgty" tableName="ip_correlation_tokens">
            <column name="identifier"/>
        </createIndex>
        <createIndex indexName="IDXdchy5i8x4p42k38necseou23o" tableName="ip_correlation_tokens">
            <column name="token"/>
        </createIndex>
    </changeSet>

    <!-- staff-temp-bans-elo-escalation: punishment sections. Each section owns a player's ELO
         score, its thresholds and how it is enforced (MUTE / BAN / SERVER). enforcement is stored
         as a string; the allowed values are enforced in the application layer (EnforcementKind). -->
    <changeSet id="create-punishment-sections" author="blackhole">
        <createTable tableName="punishment_sections">
            <column name="section_key" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="display_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="enforcement" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="base_score" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="soft_threshold" type="int"/>
            <column name="soft_duration" type="varchar(32)"/>
            <column name="permanent_threshold" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="pardon_score" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="permanent_reason" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="decay_per_day" type="int" defaultValueNumeric="10">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="seed-punishment-sections" author="blackhole">
        <insert tableName="punishment_sections">
            <column name="section_key" value="chat"/>
            <column name="display_name" value="Chat"/>
            <column name="enforcement" value="MUTE"/>
            <column name="base_score" valueNumeric="1000"/>
            <column name="soft_threshold" valueNumeric="700"/>
            <column name="soft_duration" value="PT24H"/>
            <column name="permanent_threshold" valueNumeric="300"/>
            <column name="pardon_score" valueNumeric="700"/>
            <column name="permanent_reason" value="Permanently muted after repeated chat violations"/>
            <column name="decay_per_day" valueNumeric="10"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="punishment_sections">
            <column name="section_key" value="network"/>
            <column name="display_name" value="Network"/>
            <column name="enforcement" value="BAN"/>
            <column name="base_score" valueNumeric="1000"/>
            <column name="soft_threshold" valueNumeric="700"/>
            <column name="soft_duration" value="P3D"/>
            <column name="permanent_threshold" valueNumeric="300"/>
            <column name="pardon_score" valueNumeric="700"/>
            <column name="permanent_reason" value="Permanently banned after repeated violations"/>
            <column name="decay_per_day" valueNumeric="10"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!-- Server name patterns (globs) of SERVER sections; one row per pattern. Whether a section
         may list patterns at all, and that none matches every server, is enforced in the
         application layer (ServerPatterns). -->
    <changeSet id="add-servers-to-sections" author="blackhole">
        <createTable tableName="punishment_section_servers">
            <column name="section_key" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="pattern" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="punishment_section_servers" columnNames="section_key, pattern"
                       constraintName="pk_punishment_section_servers"/>
        <addForeignKeyConstraint constraintName="fk_punishment_section_servers_section"
                                 baseTableName="punishment_section_servers" baseColumnNames="section_key"
                                 referencedTableName="punishment_sections" referencedColumnNames="section_key"/>
    </changeSet>

    <!-- One ELO score per owner and punishment section. A missing row means the section's base
         score. Replaces the chat_elo/gameplay_elo columns of elo_profiles, which are dropped by
         drop-legacy-elo-columns once no code reads them. -->
    <changeSet id="create-elo-scores" author="blackhole">
        <createTable tableName="elo_scores">
            <column name="owner" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="section_key" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="score" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="elo_scores" columnNames="owner, section_key" constraintName="pk_elo_scores"/>
        <addForeignKeyConstraint constraintName="fk_elo_scores_section"
                                 baseTableName="elo_scores" baseColumnNames="section_key"
                                 referencedTableName="punishment_sections" referencedColumnNames="section_key"/>
    </changeSet>

    <!-- elo_events.track stays (nullable) for history written before sections existed; new events
         carry section_key and leave track empty. -->
    <changeSet id="add-section-to-elo-events" author="blackhole">
        <addColumn tableName="elo_events">
            <column name="section_key" type="varchar(64)"/>
        </addColumn>
        <createIndex indexName="idx_elo_events_owner_section" tableName="elo_events">
            <column name="owner"/>
            <column name="section_key"/>
        </createIndex>
    </changeSet>

    <!-- Templates belong to a section and are addressed by a unique key (the command slug).
         punishment_templates.type and elo_delta stay (type nullable, elo_delta defaulting to 0) but
         are no longer read; a later changeset drops them. template_key is nullable for rows that
         predate this change; the application layer requires it on every template it writes. -->
    <changeSet id="add-section-columns-to-templates" author="blackhole">
        <addColumn tableName="punishment_templates">
            <column name="template_key" type="varchar(64)"/>
            <column name="section_key" type="varchar(64)"/>
        </addColumn>
        <addUniqueConstraint tableName="punishment_templates" columnNames="template_key"
                             constraintName="uk_punishment_templates_key"/>
        <addForeignKeyConstraint constraintName="fk_punishment_templates_section"
                                 baseTableName="punishment_templates" baseColumnNames="section_key"
                                 referencedTableName="punishment_sections" referencedColumnNames="section_key"/>
    </changeSet>

    <!-- Punishments know their owner and section. permanent marks the system's escalation
         punishments (no template, no expiry); lifted marks punishments that were revoked or lifted
         by a granted appeal, which escalation step selection must not count. -->
    <changeSet id="add-section-columns-to-punishments" author="blackhole">
        <addColumn tableName="punishments">
            <column name="owner" type="varchar(255)"/>
            <column name="section_key" type="varchar(64)"/>
            <column name="permanent" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="lifted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_punishments_section"
                                 baseTableName="punishments" baseColumnNames="section_key"
                                 referencedTableName="punishment_sections" referencedColumnNames="section_key"/>
    </changeSet>

    <!-- Escalation: a template lists ordered steps (duration + ELO cost) and belongs to an
         escalation group with an optional window. A punishment records the group, the chosen step,
         the step count and the deducted cost, so its history stays explainable after the template is
         edited. Durations are ISO-8601 strings, validated in the application layer. -->
    <changeSet id="create-template-steps" author="blackhole">
        <createTable tableName="punishment_template_steps">
            <column name="template_identifier" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="step_index" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="duration" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="elo_cost" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="punishment_template_steps" columnNames="template_identifier, step_index"
                       constraintName="pk_punishment_template_steps"/>
        <addForeignKeyConstraint constraintName="fk_punishment_template_steps_template"
                                 baseTableName="punishment_template_steps" baseColumnNames="template_identifier"
                                 referencedTableName="punishment_templates" referencedColumnNames="identifier"/>
        <addColumn tableName="punishment_templates">
            <column name="escalation_group" type="varchar(64)"/>
            <column name="escalation_window" type="varchar(32)"/>
        </addColumn>
        <addColumn tableName="punishments">
            <column name="escalation_group" type="varchar(64)"/>
            <column name="step_index" type="int"/>
            <column name="step_count" type="int"/>
            <column name="elo_cost" type="int"/>
        </addColumn>
        <createIndex indexName="idx_punishments_owner_group_created" tableName="punishments">
            <column name="owner"/>
            <column name="escalation_group"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- One active punishment per owner and section. Replaces the two fixed slots of
         punishment_profiles (dropped by drop-legacy-profile-slots). The primary key makes a second
         concurrent write to the same slot fail instead of silently double-occupying it. -->
    <changeSet id="create-active-punishments" author="blackhole">
        <createTable tableName="active_punishments">
            <column name="owner" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="section_key" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="punishment_identifier" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_active_punishments_punishment"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="active_punishments" columnNames="owner, section_key"
                       constraintName="pk_active_punishments"/>
        <addForeignKeyConstraint constraintName="fk_active_punishments_profile"
                                 baseTableName="active_punishments" baseColumnNames="owner"
                                 referencedTableName="punishment_profiles" referencedColumnNames="owner"/>
        <addForeignKeyConstraint constraintName="fk_active_punishments_punishment"
                                 baseTableName="active_punishments" baseColumnNames="punishment_identifier"
                                 referencedTableName="punishments" referencedColumnNames="identifier"/>
    </changeSet>

</databaseChangeLog>
