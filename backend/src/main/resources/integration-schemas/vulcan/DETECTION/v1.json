{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vulcan detection, version 1",
  "description": "A flag as the Vulcan bridge reports it. Only check is required; every other field may be absent or null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["check"],
  "properties": {
    "check": {
      "title": "Check",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "checkType": {
      "title": "Check type",
      "anyOf": [
        { "type": "string", "maxLength": 32 },
        { "type": "null" }
      ]
    },
    "violationLevel": {
      "title": "Violation level",
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 10000 },
        { "type": "null" }
      ]
    },
    "ping": {
      "title": "Ping (ms)",
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 60000 },
        { "type": "null" }
      ]
    },
    "tps": {
      "title": "TPS",
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 20.5 },
        { "type": "null" }
      ]
    },
    "experimental": {
      "title": "Experimental check",
      "type": ["boolean", "null"]
    },
    "detail": {
      "title": "Detail",
      "anyOf": [
        { "type": "string", "maxLength": 300 },
        { "type": "null" }
      ]
    }
  }
}
